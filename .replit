modules = ["nodejs-24", "python-3.11"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "EAS iOS Build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "EAS iOS Submit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "GitHub Auto Sync"

[[workflows.workflow]]
name = "EAS iOS Build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/mobile && EAS_BUILD_NO_EXPO_GO_WARNING=true EXPO_TOKEN=$EXPO_TOKEN eas build --platform ios --profile production --non-interactive 2>&1"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "EAS iOS Submit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/mobile && EAS_BUILD_NO_EXPO_GO_WARNING=true EXPO_TOKEN=$EXPO_TOKEN eas submit --platform ios --profile production --non-interactive --latest 2>&1"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "GitHub Auto Sync"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash scripts/github-sync-loop.sh"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 80

[[ports]]
localPort = 8082
externalPort = 3003

[[ports]]
localPort = 8083
externalPort = 3001

[[ports]]
localPort = 18115
externalPort = 3000

[[ports]]
localPort = 18116
externalPort = 4200

[userenv]

[userenv.shared]
GITHUB_SYNC_INTERVAL = "1800"

[userenv.production]
EXPO_PUBLIC_DOMAIN = "fix-everything.replit.app"
